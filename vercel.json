{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "installCommand": null,
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/kebijakan-privasi",
      "destination": "/privacy.html"
    },
    {
      "source": "/syarat-ketentuan",
      "destination": "/terms.html"
    },
    {
      "source": "/keamanan-data",
      "destination": "/security.html"
    },
    {
      "source": "/status-sistem",
      "destination": "/status.html"
    },
    {
      "source": "/tentang-nexa",
      "destination": "/about.html"
    },
    {
      "source": "/tentang-kami",
      "destination": "/about.html"
    },
    {
      "source": "/articles.json",
      "destination": "https://nexamos-blog.vercel.app/articles.json"
    },
    {
      "source": "/blog",
      "destination": "https://nexamos-blog.vercel.app/"
    },
    {
      "source": "/blog/:path*",
      "destination": "https://nexamos-blog.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/blog/:path*",
      "headers": [
        { "key": "X-Forwarded-Host", "value": "nexamos.cloud" },
        { "key": "X-Robots-Tag", "value": "index, follow, max-image-preview:large, max-snippet:-1" }
      ]
    }
  ]
}
